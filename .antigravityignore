# .antigravityignore — Wallaflare Workspace Context & Indexing Exclusions
# Prevents large generated bundles, caches, dependencies, and sensitive files from polluting the AI context window and indexer.

# Node dependencies & package manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Auto-generated client bundle artifacts (megabyte-scale inlined assets)
src/views/dashboard-bundle.ts
src/views/dashboard-html.ts
src/views/epub-client-bundle.ts
src/views/koplugin-bundle.ts
src/views/ota-bundle.ts
dist/
build/
www/

# Cloudflare runtime state & bindings
.wrangler/
.mf/

# Android build artifacts & Gradle caches
.gradle/
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
local.properties

# Secrets, private credentials & environment configurations
.env
.env.*
.dev.vars
wrangler.toml
!.env.example
!.dev.vars.example
!wrangler.toml.example
*.keystore
*.jks
*.pem
*.key
credentials.json

# Large binaries & release packages
*.apk
*.aab
*.epub
*.zip
*.tar*

# Test coverage & logs
coverage/
*.log

# Temporary, scratch & update staging directories
scratch/
sdr_path/
*.koplugin.update/
*.update/

# IDE, OS & editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak
*~

# AI agent & tool caches
.antigravity/cache/
.aider*
