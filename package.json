{
  "name": "wallaflare",
  "version": "1.0.0",
  "description": "A lightweight, zero-cost serverless Wallabag v2 API replacement and read-it-later service for Cloudflare Workers, D1, and E-ink readers (KOReader).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "test": "npm run build:web && vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute wallaflare-db --local --file=./schema.sql --yes",
    "db:migrate:remote": "wrangler d1 execute wallaflare-db --remote --file=./schema.sql --yes",
    "typecheck": "tsc --noEmit",
    "test:extract": "tsx scripts/test-extractors.ts",
    "build:web": "tsx scripts/build-web.ts",
    "build:apk": "tsx scripts/build-web.ts && npx cap sync android && cd android && export JAVA_HOME=/var/home/ido/.jdks/jdk-21 && export ANDROID_HOME=/home/ido/Android/Sdk && ./gradlew assembleDebug --no-daemon",
    "build:apk:release": "tsx scripts/build-web.ts && npx cap sync android && cd android && export JAVA_HOME=/var/home/ido/.jdks/jdk-21 && export ANDROID_HOME=/home/ido/Android/Sdk && ./gradlew assembleRelease --no-daemon",
    "screenshot": "tsx scripts/generate-screenshots.ts",
    "prepare": "tsx scripts/build-web.ts",
    "bundle:html": "tsx scripts/bundle-html.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.14",
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.2",
    "hono": "^4.7.2",
    "jspdf": "^4.2.1",
    "linkedom": "^0.18.9",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "puppeteer": "^25.8.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UserCel/wallaflare.git"
  },
  "keywords": [
    "wallabag",
    "cloudflare-workers",
    "cloudflare-d1",
    "koreader",
    "read-it-later",
    "epub",
    "e-ink",
    "serverless"
  ]
}
