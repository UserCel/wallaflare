{
  "name": "wallaflare",
  "version": "1.0.0",
  "description": "A lightweight, zero-cost serverless Wallabag v2 API replacement and read-it-later service for Cloudflare Workers, D1, and E-ink readers (KOReader).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute wallaflare-db --local --file=./schema.sql --yes",
    "db:migrate:remote": "wrangler d1 execute wallaflare-db --remote --file=./schema.sql --yes",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "fflate": "^0.8.2",
    "hono": "^4.7.2",
    "linkedom": "^0.18.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UserCel/wallaflare.git"
  },
  "keywords": [
    "wallabag",
    "cloudflare-workers",
    "cloudflare-d1",
    "koreader",
    "read-it-later",
    "epub",
    "e-ink",
    "serverless"
  ]
}
