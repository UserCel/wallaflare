<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/shareCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_share_card"
        android:orientation="vertical"
        android:padding="18dp"
        android:elevation="12dp">

        <!-- Top Row: Icon/Spinner, Title/Subtitle, Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp">

                <ProgressBar
                    android:id="@+id/shareSpinner"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="#f97316" />

                <ImageView
                    android:id="@+id/shareStatusIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_launcher_round"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shareTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Saving to Wallaflare..."
                    android:textColor="#f8fafc"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/shareSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Extracting article content"
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/shareCloseBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#94a3b8"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Action Buttons Row (Open Article / Open Wallaflare) -->
        <LinearLayout
            android:id="@+id/shareActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:visibility="gone">

            <Button
                android:id="@+id/btnOpenApp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Open App"
                android:textColor="#cbd5e1"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_share_btn_secondary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnOpenArticle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Read Article"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_share_btn_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
